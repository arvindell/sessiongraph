{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Session Atlas",
  "version": "0.1.0",
  "identifier": "local.sessionatlas.desktop",
  "build": {
    "beforeBuildCommand": "pnpm build && node scripts/prepare-desktop.mjs",
    "beforeDevCommand": "pnpm build && node scripts/prepare-desktop.mjs",
    "frontendDist": "../dist"
  },
  "app": { "windows": [], "security": { "csp": null } },
  "bundle": { "active": true, "targets": "all", "resources": ["resources/*", "resources/web/**/*"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "shortDescription": "Search & visualize all your LLM sessions", "category": "DeveloperTool" }
}
