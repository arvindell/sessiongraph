{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm --filter sessiongraph-site build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "git": { "deploymentEnabled": { "feat/public-profiles": false } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/explore", "destination": "/api" },
    { "source": "/@:username", "destination": "/profile" }
  ],
  "functions": { "api/index.mjs": { "maxDuration": 60, "includeFiles": "dist-api/explore.html" } },
  "crons": [{ "path": "/api/maintenance", "schedule": "0 8 * * *" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; media-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/assets/(.*)-([a-zA-Z0-9_-]{8})\\.(js|css|woff|woff2)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
