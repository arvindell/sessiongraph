{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm --filter sessiongraph-site build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "git": { "deploymentEnabled": { "feat/public-profiles": false } },
  "rewrites": [{ "source": "/@:username", "destination": "/profile.html" }],
  "functions": { "api/**/*.ts": { "maxDuration": 60 } },
  "crons": [{ "path": "/api/maintenance", "schedule": "0 8 * * *" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; media-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
