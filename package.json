{
  "name": "sessiongraph",
  "version": "0.1.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Search & visualize all your LLM sessions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arvindell/sessiongraph.git"
  },
  "license": "UNLICENSED",
  "bin": {
    "sessiongraph": "bin/sessiongraph.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "dist-server/",
    "docs/*.md",
    "README.md"
  ],
  "optionalDependencies": {
    "sessiongraph-app-darwin-arm64": "0.1.0",
    "sessiongraph-app-darwin-x64": "0.1.0",
    "sessiongraph-app-linux-arm64": "0.1.0",
    "sessiongraph-app-linux-x64": "0.1.0",
    "sessiongraph-app-win32-x64": "0.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "start": "node bin/sessiongraph.mjs --browser",
    "package:desktop": "node scripts/package-desktop.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@opencode/client": "^2.2.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "@zag-js/date-picker": "^1.47.0",
    "@zag-js/select": "^1.47.0",
    "@zag-js/vanilla": "^1.47.0",
    "esbuild": "^0.28.2",
    "lucide": "^0.468.0",
    "minisearch": "^7.2.0",
    "three": "^0.180.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "packageManager": "pnpm@11.10.0"
}
