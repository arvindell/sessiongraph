{
  "name": "atlas-sessions",
  "version": "0.1.0",
  "private": false,
  "description": "Explore your LLM sessions locally",
  "license": "UNLICENSED",
  "bin": { "atlas": "bin/atlas.mjs" },
  "files": ["bin/", "dist/", "dist-server/", "README.md"],
  "optionalDependencies": {
    "atlas-sessions-app-darwin-arm64": "0.1.0",
    "atlas-sessions-app-darwin-x64": "0.1.0",
    "atlas-sessions-app-linux-x64": "0.1.0",
    "atlas-sessions-app-linux-arm64": "0.1.0",
    "atlas-sessions-app-win32-x64": "0.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "start": "node bin/atlas.mjs --browser",
    "package:desktop": "node scripts/package-desktop.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@opencode/client": "^2.2.1",
    "lucide": "^0.468.0",
    "minisearch": "^7.2.0",
    "three": "^0.180.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "packageManager": "pnpm@11.10.0"
}
